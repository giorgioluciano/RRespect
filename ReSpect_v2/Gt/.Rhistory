return(modulus)
}
# Generate logarithmically spaced strain values
strain <- 10^seq(-2, 3, length.out = 100) # Strain amplitude values between 0.01 and 1000 in logarithmic scale
# Set parameters for Giesekus model and Kate-Gurnon and Wagner model
params_Giesekus <- c(eta = 100, lambda = 0.1, alpha = 0.01)
params_Kate_Gurnon_Wagner <- c(eta = 120, beta = 0.2, gamma = 0.5)
# Calculate modulus for Giesekus model
modulus_Giesekus <- Giesekus_model(params_Giesekus, strain)
# Calculate modulus for Kate-Gurnon and Wagner model
modulus_Kate_Gurnon_Wagner <- Kate_Gurnon_Wagner_model(params_Kate_Gurnon_Wagner, strain)
# Create a data frame for plotting
data <- data.frame(strain = strain,
modulus_Giesekus = modulus_Giesekus,
modulus_Kate_Gurnon_Wagner = modulus_Kate_Gurnon_Wagner)
# Plot the simulated data
ggplot(data, aes(x = strain)) +
geom_line(aes(y = modulus_Giesekus, color = "Giesekus Model")) +
geom_line(aes(y = modulus_Kate_Gurnon_Wagner, color = "Kate-Gurnon and Wagner Model")) +
labs(title = "Strain vs Modulus",
x = "Strain",
y = "Modulus") +
scale_x_log10() + # Set x-axis to logarithmic scale
scale_y_log10() + # Set y-axis to logarithmic scale
scale_color_manual(values = c("Giesekus Model" = "blue", "Kate-Gurnon and Wagner Model" = "red")) +
theme_minimal()
