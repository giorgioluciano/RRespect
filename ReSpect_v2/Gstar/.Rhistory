omega <- seq(0.01, 10, length.out = 100) # Range di frequenza
# Calcola il modulo di rilassamento per il tempo specificato
G_values <- G_function(t, params, omega)
# Calcola il modulo di creep per il tempo specificato
J_values <- J_function(t, params)
# Calcola il modulo di storage per la frequenza specificata
Gp_values <- Gp_function(omega, params)
# Calcola il modulo di loss per la frequenza specificata
Gpp_values <- Gpp_function(omega, params)
# Load required packages
library(ggplot2)
# Define the Giesekus model function
Giesekus_model <- function(params, strain){
# Define the parameters
eta <- params[1]
lambda <- params[2]
alpha <- params[3]
# Calculate the modulus using Giesekus model equation
modulus <- eta * (1 + lambda * strain + alpha * strain^2)
return(modulus)
}
# Define the expansion equations by Kate-Gurnon and Wagner
Kate_Gurnon_Wagner_model <- function(params, strain){
# Define the parameters
eta <- params[1]
beta <- params[2]
gamma <- params[3]
# Calculate the modulus using Kate-Gurnon and Wagner equations
modulus <- eta * (1 + beta * strain^gamma)
return(modulus)
}
# Simulate data
strain <- seq(0, 1, length.out = 100) # Range of strain values
params_Giesekus <- c(eta = 100, lambda = 0.1, alpha = 0.01) # Parameters for Giesekus model
params_Kate_Gurnon_Wagner <- c(eta = 120, beta = 0.2, gamma = 0.5) # Parameters for Kate-Gurnon and Wagner model
# Calculate modulus for Giesekus model
modulus_Giesekus <- Giesekus_model(params_Giesekus, strain)
# Calculate modulus for Kate-Gurnon and Wagner model
modulus_Kate_Gurnon_Wagner <- Kate_Gurnon_Wagner_model(params_Kate_Gurnon_Wagner, strain)
# Create a data frame for plotting
data <- data.frame(strain = strain,
modulus_Giesekus = modulus_Giesekus,
modulus_Kate_Gurnon_Wagner = modulus_Kate_Gurnon_Wagner)
# Plot the simulated data
ggplot(data, aes(x = strain)) +
geom_line(aes(y = modulus_Giesekus, color = "Giesekus Model")) +
geom_line(aes(y = modulus_Kate_Gurnon_Wagner, color = "Kate-Gurnon and Wagner Model")) +
labs(title = "Strain vs Modulus",
x = "Strain",
y = "Modulus") +
scale_color_manual(values = c("Giesekus Model" = "blue", "Kate-Gurnon and Wagner Model" = "red")) +
theme_minimal()
