# This is the main driver routine for computing the continuous spectrum
#
# Input: "par" list from "inp.dat" which specifies GexpFile (often 'Gt.dat')
# Return: H and lambdaC; the latter can be used to microspecify lambdaC as desired
#         without having to do the entire lcurve calculation again
# read input
logging::loginfo("Starting getContSpec")
if (par$verbose) {
cat(sprintf("\n(*) Start\n(*) Loading Data File: %s...\n", par$GexpFile))
}
# Get experimental data
data <- GetExpData(par$GexpFile)  # Assuming GetExpData is defined elsewhere
w <- data$w
Gexp <- data$Gst
wexp <- data$wexp
if (par$verbose) {
cat("(*) Initial Set up...")
}
# Set up some internal variables
n <- length(w)
ns <- par$ns    # discretization of 'tau'
cat("n\n")
print(n)
cat("ns\n")
print(ns)
wmin <- w[1]
wmax <- w[n]
wmax
if (par$FreqEnd == 1) {
smin <- exp(-pi/2) /wmax
smax <- exp(pi/2) /wmin
} else if (par$FreqEnd == 2) {
smin <- 1 / wmax
smax <- 1 / wmin
} else if (par$FreqEnd == 3) {
smin <- exp(pi / 2) / wmax
smax <- exp(-pi / 2) / wmin
}
hs <- (smax/smin)^(1/(ns-1))
s <- smin * hs^(0:(ns-1))
hs
s
kernMat <- getKernMat(s, w)  # Assuming getKernMat is defined elsewhere
print("kernMat")
print(kernMat)
kernMat=t(kernMat)
print(class(kernMat))
tic <- Sys.time()
if (par$plateau) {
result <- InitializeH(Gexp, wexp, s, kernMat, min(Gexp))
########################################################
Hgs <- result$Hgs
G0 <- result$G0
} else {
result <- InitializeH(Gexp, wexp, s, kernMat)
Hgs=result
print("Hgs")
print(Hgs)
}
result <- InitializeH(Gexp, wexp, s, kernMat)
H
H <- -5.0 * rep(1, length(s)) + sin(pi * s)
print("H")
print(H)
lam <- 1.0
tryCatch({
if (length(args) > 0) {
G0 <- args[[1]]
message("Debug: Calling getH with G0 = ", G0)
# Assuming getH returns a list with Hlam and G0
result <- getH(lam, Gexp, wexp, H, kernMat, G0)
print("H")
print(H)
Hlam <- result$Hlam
G0 <- result$G0
message("Debug: getH returned with Hlam length: ", length(Hlam))
message("Debug: G0: ", G0)
return(list(Hlam = Hlam, G0 = G0))
} else {
message("Debug: Calling getH without G0")
Hlam <- getH(lam, Gexp, wexp, H, kernMat)
message("Debug: getH returned with Hlam length: ", length(Hlam))
return(Hlam)
}
}
