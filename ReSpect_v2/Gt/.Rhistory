ReadData <- function(fNameGst, fNameH) {
exp_data <- GetExpData(fNameGst)
w <- exp_data$w
Gexp <- exp_data$Gexp
n <- length(w)
Gp <- Gexp[1:n]
Gpp <- Gexp[(n + 1):(2 * n)]
data <- read.table(fNameH)
s <- data[, 1]
H <- data[, 2]
return(list(w = w, Gp = Gp, Gpp = Gpp, s = s, H = H))
}
data <- ReadData(par$GstFile, 'output/H.dat')
w <- data$w
Gp <- data$Gp
Gpp <- data$Gpp
s <- data$s
H <- data$H
n <- length(w)
ns <- length(s)
