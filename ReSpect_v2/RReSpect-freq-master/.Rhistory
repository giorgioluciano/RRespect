smin <- exp(-pi/2) /wmax
smax <- exp(pi/2) /wmin
} else if (par$FreqEnd == 2) {
smin <- 1 / wmax
smax <- 1 / wmin
} else if (par$FreqEnd == 3) {
smin <- exp(pi / 2) / wmax
smax <- exp(-pi / 2) / wmin
}
hs <- (smax/smin)^(1/(ns-1))
s <- smin * hs^(0:(ns-1))
kernMat <- getKernMat(s, w)  # Assuming getKernMat is defined elsewhere
