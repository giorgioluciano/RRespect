plot_ly() %>%
add_trace(
type = "isosurface",
x = rep(x_vals, each = length(y_vals) * length(z_vals)),
y = rep(y_vals, each = length(z_vals)),
z = rep(z_vals, length(x_vals) * length(y_vals)),
value = as.vector(values_3d),
isomin = min_val * 0.9,  # Adjust min threshold
isomax = max_val * 0.9,  # Adjust max threshold
surface = list(show = TRUE, fill = 0.8),
caps = list(x = list(show = FALSE), y = list(show = FALSE), z = list(show = FALSE))
) %>%
layout(scene = list(
xaxis = list(title = "x"),
yaxis = list(title = "y"),
zaxis = list(title = "z")
))
library(plotly)
# Define the function
f <- function(x, y, z) {
((x-2.82)^2 + (y-2.82)^2 + z^2) +
((x-4)^2 + y^2 + z^2) +
(x^2 + (y-4)^2 + z^2) +
((x-2.82)^2 + (y+2.82)^2 + z^2) +
(x^2 + (y+4)^2 + z^2) +
((x+2.82)^2 + (y+2.82)^2 + z^2) +
((x+4)^2 + y^2 + z^2) +
((x+2.82)^2 + (y-2.82)^2 + z^2) +
((x-4.23)^2 + (y-4.23)^2 + z^2) +
((x-6)^2 + y^2 + z^2) +
(x^2 + (y-6)^2 + z^2) +
((x+4.23)^2 + (y+4.23)^2 + z^2) +
((x+6)^2 + y^2 + z^2) +
((x+4.23)^2 + (y-4.23)^2 + z^2)
}
# Create a grid of points
x <- y <- z <- seq(-8, 8, length.out = 50)
grid <- expand.grid(x = x, y = y, z = z)
# Calculate function values
grid$value <- with(grid, f(x, y, z))
# Create the 3D contour plot
plot_ly(grid, x = ~x, y = ~y, z = ~z, value = ~value, type = "isosurface",
isomin = 0, isomax = 100, colorscale = "Viridis") %>%
layout(scene = list(aspectmode = "data"))
library(plotly)
# Define the function
f <- function(x, y, z) {
((x-2.82)^2 + (y-2.82)^2 + z^2) +
((x-4)^2 + y^2 + z^2) +
(x^2 + (y-4)^2 + z^2) +
((x-2.82)^2 + (y+2.82)^2 + z^2) +
(x^2 + (y+4)^2 + z^2) +
((x+2.82)^2 + (y+2.82)^2 + z^2) +
((x+4)^2 + y^2 + z^2) +
((x+2.82)^2 + (y-2.82)^2 + z^2) +
((x-4.23)^2 + (y-4.23)^2 + z^2) +
((x-6)^2 + y^2 + z^2) +
(x^2 + (y-6)^2 + z^2) +
((x+4.23)^2 + (y+4.23)^2 + z^2) +
((x+6)^2 + y^2 + z^2) +
((x+4.23)^2 + (y-4.23)^2 + z^2)
}
# Create a grid of points
x <- y <- z <- seq(-8, 8, length.out = 50)
grid <- expand.grid(x = x, y = y, z = z)
# Calculate function values
grid$value <- with(grid, f(x, y, z))
# Find appropriate isomin and isomax values
min_val <- min(grid$value)
max_val <- max(grid$value)
range_val <- max_val - min_val
# Create the 3D contour plot
plot_ly(grid, x = ~x, y = ~y, z = ~z, value = ~value, type = "isosurface",
isomin = min_val + 0.1 * range_val,
isomax = max_val - 0.1 * range_val,
colorscale = "Viridis") %>%
layout(scene = list(aspectmode = "data"))
# Print range of values for debugging
print(paste("Min value:", min_val))
print(paste("Max value:", max_val))
library(plotly)
# Define the function
f <- function(x, y, z) {
exp(-(((x-2.82)^2+(y-2.82)^2+(z)^2))) +
exp(-(((x-4)^2+(y)^2+(z)^2))) +
exp(-(((x)^2+(y-4)^2+(z)^2))) +
exp(-(((x-2.82)^2+(y+2.82)^2+(z)^2))) +
exp(-(((x)^2+(y+4)^2+(z)^2))) +
exp(-(((x+2.82)^2+(y+2.82)^2+(z)^2))) +
exp(-(((x+4)^2+(y)^2+(z)^2))) +
exp(-(((x+2.82)^2+(y-2.82)^2+(z)^2))) +
exp(-(((x-4.23)^2+(y-4.23)^2+(z)^2))) +
exp(-(((x-6)^2+(y)^2+(z)^2))) +
exp(-(((x)^2+(y-6)^2+(z)^2))) +
exp(-(((x+4.23)^2+(y+4.23)^2+(z)^2))) +
exp(-(((x)^2+(y+6)^2+(z)^2))) +
exp(-(((x+4.23)^2+(y-4.23)^2+(z)^2))) +
exp(-(((x+6)^2+(y)^2+(z)^2))) +
0.75 * (
exp(-(((x-5.11)^2+(y-2.1)^2+(z-1.8)^2))) +
exp(-(((x-2.1)^2+(y-5.1)^2+(z-1.8)^2))) +
exp(-(((x+2.11)^2+(y-5.1)^2+(z-1.8)^2))) +
exp(-(((x+5.1)^2+(y-2.1)^2+(z-1.8)^2))) +
exp(-(((x+5.11)^2+(y+2.1)^2+(z-1.8)^2))) +
exp(-(((x+2.1)^2+(y+5.1)^2+(z-1.8)^2))) +
exp(-(((x-5.11)^2+(y+2.1)^2+(z-1.8)^2))) +
exp(-(((x-2.1)^2+(y+5.1)^2+(z-1.8)^2)))
) +
0.75 * (
exp(-(((x-5.11)^2+(y-2.1)^2+(z+1.8)^2))) +
exp(-(((x-2.1)^2+(y-5.1)^2+(z+1.8)^2))) +
exp(-(((x+2.11)^2+(y-5.1)^2+(z+1.8)^2))) +
exp(-(((x+5.1)^2+(y-2.1)^2+(z+1.8)^2))) +
exp(-(((x+5.11)^2+(y+2.1)^2+(z+1.8)^2))) +
exp(-(((x+2.1)^2+(y+5.1)^2+(z+1.8)^2))) +
exp(-(((x-5.11)^2+(y+2.1)^2+(z+1.8)^2))) +
exp(-(((x-2.1)^2+(y+5.1)^2+(z+1.8)^2)))
) - 0.17
}
# Create a grid of points
x <- y <- seq(-8, 8, length.out = 50)
z <- seq(-3.25, 3.25, length.out = 50)
grid <- expand.grid(x = x, y = y, z = z)
# Calculate function values
grid$value <- with(grid, f(x, y, z))
# Create the 3D contour plot
plot_ly(grid, x = ~x, y = ~y, z = ~z, value = ~value, type = "isosurface",
isomin = 0, isomax = max(grid$value),
colorscale = "Viridis", caps = list(x = list(show = FALSE), y = list(show = FALSE), z = list(show = FALSE))) %>%
