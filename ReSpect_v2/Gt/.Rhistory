return(list(c(d_stress, d_strain_rate)))
}
# Parametri del modello
parameters <- c(eta = 1, lambda = 0.1, alpha = 0.01)
# Condizioni iniziali
initial_state <- c(stress = 0, strain_rate = 0)
# Definizione del tempo di integrazione
times <- seq(0, 200, length.out = 1000)  # 200 cicli sinusoidali
# Integrazione numerica delle equazioni differenziali
solution <- ode(y = initial_state, times = times, func = giesekus_model, method = "rk4", parms = parameters)
# Estrazione dello stress
stress <- solution[, "stress"]
# Plot dello stress nel tempo
plot(times, stress, type = "l", xlab = "Tempo", ylab = "Stress", main = "Stress nel tempo per il modello di Giesekus (utilizzando RK4)")
# Caricamento dei pacchetti
library(deSolve)
# Definizione della funzione per il modello di Giesekus
giesekus_model <- function(time, state, parameters) {
eta <- parameters["eta"]
lambda <- parameters["lambda"]
alpha <- parameters["alpha"]
stress <- state["stress"]
strain_rate <- state["strain_rate"]
# Equazioni costitutive del modello di Giesekus
d_stress <- (eta * strain_rate + lambda * stress * strain_rate + alpha * stress * strain_rate^2) / (1 + lambda * time)
d_strain_rate <- 1
return(list(c(d_stress, d_strain_rate)))
}
