list_files_recursive <- function(path) {
files <- list.files(path, pattern = "\\.R$", full.names = TRUE)
dirs <- list.dirs(path, full.names = TRUE, recursive = FALSE)
for (dir in dirs) {
files <- c(files, list_files_recursive(dir))
}
return(files)
}
