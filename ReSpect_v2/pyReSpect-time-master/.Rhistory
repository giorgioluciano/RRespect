GridDensity <- function(x, px, N) {
npts <- 100
xi <- seq(min(x), max(x), length.out = npts)
fint <- splinefun(x, px, method = "cubic")
pint <- fint(xi)
ci <- cumtrapz(xi, pint)
pint <- pint / max(ci)
ci <- ci / max(ci)
alfa <- 1 / (N - 1)
zij <- numeric(N + 1)
z <- numeric(N)
z[1] <- min(x)
z[N] <- max(x)
beta <- seq(0.5, N - 0.5, by = 1) * alfa
zij[1] <- z[1]
zij[N + 1] <- z[N]
fint_ci <- splinefun(ci, xi, method = "cubic")
zij[2:N] <- fint_ci(beta)
h <- diff(zij)
beta <- seq(1, N - 1, by = 1) * alfa
z[2:(N-1)] <- fint_ci(beta)
return(list(z = z, h = h))
}
