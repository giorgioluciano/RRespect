par <- setParameters("C:/test/Gstar/tests/test1.dat")
inp     <- GetExpData(par$GstFile)
w       <- inp$w
Gexp    <- inp$Gst
wexp    <- inp$wexp
n       <- length(w)
ns      <- par$ns
wmin <- w[1]; wmax <- w[n]
smin <- 1/wmax; smax <- 1/wmin          # FreqEnd=2
hs   <- (smax/smin)^(1/(ns-1))
s    <- smin * hs^(0:(ns-1))
kernMat <- getKernMat(s, w)
# Stampa dimensioni
cat("n =", n, "\n")
cat("ns =", ns, "\n")
cat("length(Gexp) =", length(Gexp), "\n")
cat("length(wexp) =", length(wexp), "\n")
cat("dim(kernMat) =", dim(kernMat), "\n")
# Test kernel_prestore
H_test <- rep(-5, ns)
K <- kernel_prestore(H_test, kernMat)
cat("length(K) =", length(K), "\n")
# Test residualLM direttamente
r <- residualLM(H_test, 1e0, Gexp, wexp, kernMat)
cat("length(r) =", length(r), "\n")
J <- jacobianLM(H_test, 1e0, Gexp, wexp, kernMat)
