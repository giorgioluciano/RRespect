G0 <- result$G0
logging::logdebug(sprintf("After getH call (with plateau): G0=%.3e", G0))
cat(sprintf("G0 = %.3e ...", G0))
} else {
logging::logdebug(sprintf("Before getH call (without plateau): lamC=%.3e", lamC))
H <- getH(lamC, Gexp, wexp, Hgs, kernMat)
logging::logdebug(sprintf("After getH call (without plateau)"))
}
