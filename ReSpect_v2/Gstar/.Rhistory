denom <- k * sums[,2] - sums[,1]^2
a <- (sums[,3] * sums[,2] - sums[,1] * sums[,4]) / denom
b <- (k * sums[,4] - sums[,1] * sums[,3]) / denom
smo <- a + b * x
# Calcolo dell'acvr
sums_cv <- sums - data
denom_cv <- (k-1) * sums_cv[,2] - sums_cv[,1]^2
a_cv <- (sums_cv[,3] * sums_cv[,2] - sums_cv[,1] * sums_cv[,4]) / denom_cv
b_cv <- ((k-1) * sums_cv[,4] - sums_cv[,1] * sums_cv[,3]) / denom_cv
smo_cv <- a_cv + b_cv * x
acvr <- abs(smo_cv - y)
list(smo = smo, acvr = acvr)
}
smooth_per <- function(x, y, w, span, period) {
n <- length(y)
m <- max(round(0.5 * span * n), 2)
k <- 2 * m + 1
x_extended <- c(x, x[1:(k-1)] + period)
y_extended <- c(y, y[1:(k-1)])
xy <- y_extended * x_extended
data <- cbind(x_extended, x_extended^2, y_extended, xy)
cs <- rbind(0, apply(data, 2, cumsum))
sums <- cs[(k+1):(n+k),] - cs[1:n,]
denom <- k * sums[,2] - sums[,1]^2
a <- (sums[,3] * sums[,2] - sums[,1] * sums[,4]) / denom
b <- (k * sums[,4] - sums[,1] * sums[,3]) / denom
smo <- c(a[(m+1):n] + b[(m+1):n] * x[(m+1):n],
a[1:m] + b[1:m] * x[1:m])
# Calcolo dell'acvr
sums_cv <- sums - data[(m+1):(n+m),]
denom_cv <- (k-1) * sums_cv[,2] - sums_cv[,1]^2
a_cv <- (sums_cv[,3] * sums_cv[,2] - sums_cv[,1] * sums_cv[,4]) / denom_cv
b_cv <- ((k-1) * sums_cv[,4] - sums_cv[,1] * sums_cv[,3]) / denom_cv
smo_cv <- c(a_cv[(m+1):n] + b_cv[(m+1):n] * x[(m+1):n],
a_cv[1:m] + b_cv[1:m] * x[1:m])
acvr <- abs(smo_cv - y)
list(smo = smo, acvr = acvr)
}
