# 5. PAZIENTI CON VALORI MANCANTI CRITICI
# ========================================
pazienti_NA_critici <- df %>%
filter(is.na(Peso_kg) | is.na(BMI) | is.na(sesso) | is.na(terapia)) %>%
group_by(ID_PAZIENTE) %>%
summarise(
n_righe_con_NA = n(),
variabili_mancanti = paste(
unique(c(
if(any(is.na(Peso_kg))) "Peso_kg",
if(any(is.na(BMI))) "BMI",
if(any(is.na(sesso))) "sesso",
if(any(is.na(terapia))) "terapia"
)),
collapse = ", "
),
.groups = "drop"
) %>%
mutate(problema = paste0("Valori mancanti: ", variabili_mancanti))
# ========================================
# 6. PAZIENTI CON TIMEPOINT ANOMALI
# ========================================
pazienti_timepoint_anomali <- df %>%
group_by(ID_PAZIENTE) %>%
summarise(
timepoints = paste(sort(unique(followup_mesi)), collapse = ", "),
ha_negativi = any(followup_mesi < 0, na.rm = TRUE),
ha_NA_tempo = any(is.na(followup_mesi)),
.groups = "drop"
) %>%
filter(ha_negativi | ha_NA_tempo) %>%
mutate(problema = case_when(
ha_negativi ~ "Followup negativo",
ha_NA_tempo ~ "Followup mancante (NA)",
TRUE ~ "Timepoint anomalo"
))
# ========================================
# 7. PAZIENTI CON VALORI BIOLOGICI ESTREMI
# ========================================
pazienti_outlier <- df %>%
filter(
BMI < 15 | BMI > 70 |
Peso_kg < 30 | Peso_kg > 250 |
(!is.na(Glu) & (Glu < 50 | Glu > 500))
) %>%
group_by(ID_PAZIENTE) %>%
summarise(
outlier_rilevati = paste(unique(c(
if(any(BMI < 15 | BMI > 70, na.rm = TRUE)) "BMI estremo",
if(any(Peso_kg < 30 | Peso_kg > 250, na.rm = TRUE)) "Peso estremo",
if(any(Glu < 50 | Glu > 500, na.rm = TRUE)) "Glicemia estrema"
)), collapse = ", "),
.groups = "drop"
) %>%
mutate(problema = paste0("Valori sospetti: ", outlier_rilevati))
# ========================================
# UNIONE DI TUTTI I PROBLEMI
# ========================================
report_problemi <- bind_rows(
pazienti_senza_T0 %>% select(ID_PAZIENTE, problema),
pazienti_visita_unica %>% select(ID_PAZIENTE, problema),
pazienti_duplicati %>% select(ID_PAZIENTE, problema),
pazienti_cambio_terapia %>% select(ID_PAZIENTE, problema),
pazienti_NA_critici %>% select(ID_PAZIENTE, problema),
pazienti_timepoint_anomali %>% select(ID_PAZIENTE, problema),
pazienti_outlier %>% select(ID_PAZIENTE, problema)
) %>%
left_join(
df %>%
group_by(ID_PAZIENTE) %>%
slice(1) %>%
select(ID_PAZIENTE, sesso, eta, terapia),
by = "ID_PAZIENTE"
) %>%
left_join(
df %>%
group_by(ID_PAZIENTE) %>%
summarise(
n_visite = n(),
timepoints = paste(sort(unique(followup_mesi)), collapse = ", "),
.groups = "drop"
),
by = "ID_PAZIENTE"
) %>%
arrange(ID_PAZIENTE)
# ========================================
# PAZIENTI "SANI" (per confronto)
# ========================================
pazienti_ok <- df %>%
distinct(ID_PAZIENTE) %>%
anti_join(report_problemi, by = "ID_PAZIENTE") %>%
left_join(
df %>%
group_by(ID_PAZIENTE) %>%
slice(1) %>%
select(ID_PAZIENTE, sesso, eta, terapia),
by = "ID_PAZIENTE"
) %>%
left_join(
df %>%
group_by(ID_PAZIENTE) %>%
summarise(
n_visite = n(),
timepoints = paste(sort(unique(followup_mesi)), collapse = ", "),
.groups = "drop"
),
by = "ID_PAZIENTE"
) %>%
mutate(problema = "Nessun problema rilevato")
# ========================================
# EXPORT IN EXCEL
# ========================================
wb <- createWorkbook()
# Foglio 1: Pazienti problematici
addWorksheet(wb, "Pazienti_Problematici")
writeData(wb, "Pazienti_Problematici", report_problemi)
# Formattazione condizionale
conditionalFormatting(
wb, "Pazienti_Problematici",
cols = 1:ncol(report_problemi),
rows = 1:(nrow(report_problemi) + 1),
rule = "TRUE",
style = createStyle(fontSize = 11, fontColour = "#9C0006", bgFill = "#FFC7CE")
)
# Foglio 2: Pazienti OK
addWorksheet(wb, "Pazienti_OK")
writeData(wb, "Pazienti_OK", pazienti_ok)
# Foglio 3: Riepilogo numerico
riepilogo <- tibble(
Categoria = c(
"Totale pazienti",
"Pazienti con problemi",
"Pazienti senza problemi",
"- Manca baseline T0",
"- Solo una visita",
"- Duplicati timepoint",
"- Cambio terapia",
"- Valori mancanti critici",
"- Timepoint anomali",
"- Outlier biologici"
),
N_Pazienti = c(
n_distinct(df$ID_PAZIENTE),
n_distinct(report_problemi$ID_PAZIENTE),
n_distinct(pazienti_ok$ID_PAZIENTE),
nrow(pazienti_senza_T0),
nrow(pazienti_visita_unica),
n_distinct(pazienti_duplicati$ID_PAZIENTE),
nrow(pazienti_cambio_terapia),
nrow(pazienti_NA_critici),
nrow(pazienti_timepoint_anomali),
nrow(pazienti_outlier)
)
)
addWorksheet(wb, "Riepilogo")
writeData(wb, "Riepilogo", riepilogo)
# Salva
saveWorkbook(wb, "Report_Diagnostico_Pazienti.xlsx", overwrite = TRUE)
cat("✅ Report salvato: Report_Diagnostico_Pazienti.xlsx\n")
cat("📊 Pazienti problematici:", n_distinct(report_problemi$ID_PAZIENTE), "\n")
cat("✔️  Pazienti OK:", n_distinct(pazienti_ok$ID_PAZIENTE), "\n")
library(dplyr)
library(tidyr)
library(mmrm)
library(geepack)
library(emmeans)
library(purrr)
df <- df %>%
group_by(id) %>%
arrange(tempo) %>%
mutate(across(
all_of(vars_analisi),
~ (. - .[tempo == 0]) / .[tempo == 0] * 100,
.names = "{.col}_delta_pct"
)) %>%
ungroup()
library(dplyr)
library(openxlsx)
# ========================================
# 1. PAZIENTI SENZA BASELINE (T0)
# ========================================
pazienti_senza_T0 <- df %>%
group_by(ID_PAZIENTE) %>%
summarise(
ha_T0 = any(followup_mesi == 0, na.rm = TRUE),
.groups = "drop"
) %>%
filter(!ha_T0) %>%
mutate(problema = "Manca baseline (followup_mesi = 0)")
# ========================================
# 2. PAZIENTI CON UNA SOLA VISITA
# ========================================
pazienti_visita_unica <- df %>%
group_by(ID_PAZIENTE) %>%
summarise(
n_visite = n(),
timepoints = paste(sort(unique(followup_mesi)), collapse = ", "),
.groups = "drop"
) %>%
filter(n_visite == 1) %>%
mutate(problema = "Solo una visita registrata")
# ========================================
# 3. DUPLICATI REALI (stessa data/timepoint)
# ========================================
duplicati_reali <- df %>%
group_by(ID_PAZIENTE, followup_mesi) %>%
filter(n() > 1) %>%
arrange(ID_PAZIENTE, followup_mesi) %>%
mutate(problema = "Righe duplicate per stesso timepoint") %>%
ungroup()
pazienti_duplicati <- duplicati_reali %>%
distinct(ID_PAZIENTE, .keep_all = TRUE) %>%
select(ID_PAZIENTE, problema, followup_mesi_duplicati = followup_mesi)
